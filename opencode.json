{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cloudflare": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@cloudflare/mcp-server-cloudflare",
        "run"
      ],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "CLOUDFLARE_API_TOKEN": "{env:CLOUDFLARE_API_TOKEN}",
        "CLOUDFLARE_ACCOUNT_ID": "{env:CLOUDFLARE_ACCOUNT_ID}"
      }
    },
    "uptime-kuma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@davidfuchs/mcp-uptime-kuma"
      ],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "UPTIME_KUMA_URL": "http://127.0.0.1:3001",
        "UPTIME_KUMA_USERNAME": "ak",
        "UPTIME_KUMA_PASSWORD": "i6C%B&HNSCOifc"
      }
    },
    "n8n": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "n8n-mcp"
      ],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "N8N_BASE_URL": "http://127.0.0.1:5678",
        "N8N_API_KEY": "{env:N8N_API_KEY}"
      }
    },
    "godot": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "godot-mcp"
      ],
      "enabled": false,
      "timeout": 30000
    },
    "dart-flutter": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server",
        "--force-roots-fallback"
      ],
      "enabled": false,
      "timeout": 30000
    },
    "tauri": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@hypothesi/tauri-mcp-server"
      ],
      "enabled": false,
      "timeout": 60000
    },
    "mobile": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mobile-mcp"
      ],
      "enabled": false,
      "timeout": 60000,
      "environment": {
        "ANDROID_SDK_ROOT": "/opt/android-sdk",
        "ANDROID_HOME": "/opt/android-sdk"
      }
    },
    "virustotal": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@burtthecoder/mcp-virustotal"
      ],
      "enabled": false,
      "timeout": 60000,
      "environment": {
        "VIRUSTOTAL_API_KEY": "{env:VIRUSTOTAL_API_KEY}"
      }
    },
    "shodan": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@burtthecoder/mcp-shodan"
      ],
      "enabled": false,
      "timeout": 60000,
      "environment": {
        "SHODAN_API_KEY": "{env:SHODAN_API_KEY}"
      }
    },
    "dnstwist": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@burtthecoder/mcp-dnstwist"
      ],
      "enabled": false,
      "timeout": 120000,
      "format": "json"
    },
    "cyberlens": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@shadoprizm/cyberlens-mcp-server"
      ],
      "enabled": false,
      "timeout": 60000
    },
    "malwarebazaar": {
      "type": "local",
      "command": [
        "/root/code/MalwareBazaar_MCP/.venv/bin/python",
        "/root/code/MalwareBazaar_MCP/malwarebazaar_mcp.py"
      ],
      "enabled": false,
      "timeout": 60000,
      "environment": {
        "MALWAREBAZAAR_API_KEY": "{env:MALWAREBAZAAR_API_KEY}"
      }
    },
    "diagrams-custom": {
      "type": "local",
      "command": [
        "/root/.local/bin/uvx",
        "--from",
        "diagrams-mcp==1.0.0",
        "diagrams-mcp"
      ],
      "enabled": false,
      "timeout": 120000
    },
    "infrastructure-diagram": {
      "type": "local",
      "command": [
        "/root/.local/bin/uvx",
        "--python",
        "3.13",
        "--from",
        "infrastructure-diagram-mcp-server==0.0.4.3",
        "--with",
        "mcp[cli]<2",
        "infrastructure-diagram-mcp-server"
      ],
      "enabled": false,
      "timeout": 120000
    },
    "drawio": {
      "type": "local",
      "command": [
        "/root/.local/bin/uvx",
        "--from",
        "drawio-mcp==1.0.2",
        "--with",
        "mcp<2",
        "drawio-mcp"
      ],
      "enabled": false,
      "timeout": 120000
    },
    "excalidraw": {
      "type": "remote",
      "url": "http://localhost:3032/mcp",
      "enabled": false,
      "timeout": 60000
    },
    "mcp-diagram-generator": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-diagram-generator@1.2.0"
      ],
      "enabled": false,
      "timeout": 60000
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp@3.23.7"
      ],
      "enabled": false,
      "timeout": 120000,
      "environment": {
        "FIRECRAWL_API_URL": "http://localhost:3002"
      }
    },
    "groktocrawl": {
      "type": "remote",
      "url": "http://localhost:8002/mcp",
      "enabled": false,
      "timeout": 120000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--no-sandbox",
        "--headless"
      ],
      "enabled": false,
      "timeout": 60000
    },
    "lsp-python": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@treedy/lsp-mcp@0.2.8"
      ],
      "enabled": false,
      "timeout": 60000
    }
  }
}